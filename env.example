# Template for the local .env — copy it and fill in. .env is never committed.
#   Copy-Item env.example .env
#
# Note: this file is named without the leading dot because the agent harness
# blocks writes to .env* paths. Django reads .env (see config/settings.py).

# Django
# Generate a key:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Required once the app is served on a non-standard port, e.g. http://<ip>:8080
CSRF_TRUSTED_ORIGINS=

# Admin account, provisioned by `manage.py ensure_admin` on every deploy.
# The assignment requires admin:demo on the demo site; override for anything else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo
ADMIN_EMAIL=

# Database — the only place the engine is chosen
# dev:  sqlite:///db.sqlite3
# prod: postgres://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=sqlite:///db.sqlite3

# Persistent DB connections. Leave at 0 with the dev server; behind gunicorn
# with Postgres set CONN_MAX_AGE=60 and CONN_HEALTH_CHECKS=True.
CONN_MAX_AGE=0
CONN_HEALTH_CHECKS=False

# HMS Servio integration (see docs/servio-api.md)
# Neither identifier is a secret — both are visible in the public widget.
SERVIO_API_BASE=https://smartspot.servio.support/ServioQR/hms/api
SERVIO_COMPANY_KEY=6DFA7A01-9E5E-4087-8073-1E0254672737
SERVIO_HOTEL_ID=161
SERVIO_TIMEOUT=15

# Logging: DEBUG here makes every Servio call verbose
LOG_LEVEL=INFO

# This site sends no mail; override only if a deployment needs SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend


# ---------------------------------------------------------------------------
# Server / docker compose only — not needed for local development.
# docker-compose.yml reads these from the .env next to it.
# ---------------------------------------------------------------------------

# Postgres container. DATABASE_URL is assembled from these by compose,
# so do NOT set DATABASE_URL on the server.
# POSTGRES_DB=booking
# POSTGRES_USER=booking
# POSTGRES_PASSWORD=            # required, no default on purpose

# Image to run. Leave unset to build on the server; Phase 9 sets it to GHCR.
# WEB_IMAGE=ghcr.io/OWNER/demo-booking:latest

# Host port. The assignment requires 8080.
# WEB_PORT=8080

# gunicorn. Timeout is generous because Servio search takes ~9s and the
# booking step makes three consecutive calls to it.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120

# TLS-only switches. The demo runs on plain HTTP per the assignment; turn
# these on only behind real HTTPS, otherwise the site stops working.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
