# Template for the local .env — copy it and fill in. .env is never committed.
#   Copy-Item env.example .env
#
# Note: this file is named without the leading dot because the agent harness
# blocks writes to .env* paths. Django reads .env (see config/settings.py).

# Django
# Generate a key:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Required once the app is served on a non-standard port, e.g. http://<ip>:8080
CSRF_TRUSTED_ORIGINS=

# Database — the only place the engine is chosen
# dev:  sqlite:///db.sqlite3
# prod: postgres://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=sqlite:///db.sqlite3

# HMS Servio integration
SERVIO_API_BASE=https://smartspot.servio.support/ServioQR/hms/api
SERVIO_HOTEL_ID=
SERVIO_TIMEOUT=15
